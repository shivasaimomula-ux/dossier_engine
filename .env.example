# Stage C (dossier_engine-harden-c) — copy to .env (never commit .env).
# Runtime loads ONLY project-root .env as KEY=value lines.
# .env.txt is NOT loaded (Audit #23 / Task T24). Migrate any key blob into .env.
#
# Port contract: 8010

# --- Required for safety adjudication / pipeline_ready ---
# Prefer blue adjudication (:8011) for NIM→Gemini→Claude-hard-reject (N5.1).
# Local Claude is fallback when adjudication is down.
ANTHROPIC_API_KEY=

# Optional — override default authenticator model (Claude fallback only):
# AUTHENTICATOR_MODEL=claude-sonnet-5

# Blue citation adjudication (cost lock-in — default ON):
# ADJUDICATION_PREFERRED=1
# ADJUDICATION_URL=http://127.0.0.1:8011
# ADJUDICATION_TIMEOUT_S=8

# Optional — webserver port (default 8010):
# PORT=8010

# Optional — refuse startup without ANTHROPIC_API_KEY (glue/pipeline):
# PIPELINE_MODE=1

# Citation trust for UNVERIFIED (auth-error) efficacy PMIDs:
#   strict (default / unset) — omit from compiled citations (fail-closed)
#   demo — soft-retain on MeSH gate + UNVERIFIED caveat (legacy exploration)
# PIPELINE_TRUST=strict

# Optional — shared PubMed/PMID cache (B-vendored package; same env as A/B/adj):
# HERBENZO_PUBMED_CACHE_DIR=$HOME/Desktop/herbenzo_shared_cache/pubmed
# HERBENZO_PUBMED_CACHE_TTL_S=2592000
# NCBI_API_KEY=
# NCBI_EMAIL=research@herbenzo.example

# Optional provider keys (used by blue adjudication service, not C directly):
# NVIDIA_API_KEY=
# GEMINI_API_KEY=

# Async analyze jobs (Task T18 / Finding #14) — demo-sensible defaults:
# ANALYZE_JOB_TIMEOUT_S=540
# ANALYZE_MAX_CONCURRENT_JOBS=2
# ANALYZE_JOB_RETENTION_S=3600
