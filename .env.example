# Copy to .env (never commit .env). Local KEY=value only.
# Required for Claude citation adjudication (efficacy + safety):
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — override default authenticator model:
# AUTHENTICATOR_MODEL=claude-sonnet-5

# Optional — webserver port (default 8010):
# PORT=8010

# Optional — refuse startup without ANTHROPIC_API_KEY (glue/pipeline):
# PIPELINE_MODE=1

# Citation trust for UNVERIFIED (auth-error) efficacy PMIDs:
#   strict (default / unset) — omit from compiled citations (fail-closed)
#   demo — soft-retain on MeSH gate + UNVERIFIED caveat (legacy exploration)
# PIPELINE_TRUST=strict

# Async analyze jobs (Task T18 / Finding #14):
# ANALYZE_JOB_TIMEOUT_S=540
# ANALYZE_MAX_CONCURRENT_JOBS=2
# ANALYZE_JOB_RETENTION_S=3600
